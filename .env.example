# OpenClaw: configure on Tencent Lighthouse; never commit .env.
HOST=127.0.0.1
PORT=4173
# Set the exact deployed HTTPS origin, without trailing slash.
PUBLIC_ORIGIN=https://hexabridgepng.com
# Set to 1 only behind a trusted reverse proxy overwriting X-Real-IP.
TRUST_PROXY=0
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Provider-verified sending address, e.g. HexaBridge <inquire@hexabridgepng.com>
SMTP_FROM=
# Recipient is fixed in server.mjs: inquire@hexabridgepng.com
